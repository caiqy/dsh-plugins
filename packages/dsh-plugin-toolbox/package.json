{
  "name": "@caiqy/dsh-plugin-toolbox",
  "version": "0.2.2",
  "description": "DSH 工具箱：实用工具、便捷操作与兼容性修复。",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caiqy/dsh-plugins.git",
    "directory": "packages/dsh-plugin-toolbox"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/client.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "res", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.4" },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4" },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "~18.3.1",
    "typescript": "catalog:",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "esbuild": "^0.25.0"
  }
}
